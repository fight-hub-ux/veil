# Neon Postgres connection strings.
#
# DATABASE_URL  — pooled (PgBouncer) connection used by the app at runtime.
# DIRECT_URL    — direct, non-pooled connection used for migrations and
#                 introspection (Prisma `migrate`/`db` commands). Neon exposes
#                 both from the dashboard; the direct URL omits "-pooler".
#
# Both are required. Never commit the real values — copy this file to .env(.local)
# and fill in. Production migrations run via `prisma migrate deploy`, gated to
# VERCEL_ENV=production by scripts/migrate-prod.mjs.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/veil?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/veil?sslmode=require"
